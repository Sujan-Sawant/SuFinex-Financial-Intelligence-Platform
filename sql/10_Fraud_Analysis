--=============================================================
--08: Top 10 High-Value Fraudulent Transactions
--=============================================================

SELECT
    t.transaction_id,
    t.amount,
    t.transaction_type,
    t.transaction_status,
    f.fraud_prediction
FROM fraud_prediction AS f
INNER JOIN transactions AS t
    ON f.transaction_id = t.transaction_id
WHERE
    f.fraud_prediction = 'Fraud'
ORDER BY
    t.amount DESC
LIMIT 10;


--=============================================================
--09: Fraud Exposure by Customer
--=============================================================

SELECT
    c.customer_id,
    c.first_name,
    c.last_name,
    COUNT(*) AS fraud_transactions,
    SUM(t.amount) AS fraud_transaction_value
FROM fraud_prediction AS f
INNER JOIN transactions AS t
    ON f.transaction_id = t.transaction_id
INNER JOIN account AS a
    ON t.account_id = a.account_id
INNER JOIN customer AS c
    ON a.customer_id = c.customer_id
WHERE
    f.fraud_prediction = 'Fraud'
GROUP BY
    c.customer_id,
    c.first_name,
    c.last_name
ORDER BY
    fraud_transaction_value DESC
LIMIT 10;


--=============================================================
--10: Monthly Fraud Trend
--=============================================================

SELECT
    DATE_TRUNC('month', t.transaction_timestamp) AS transaction_month,
    COUNT(*) AS fraud_transactions,
    SUM(t.amount) AS fraud_transaction_value
FROM fraud_prediction AS f
INNER JOIN transactions AS t
    ON f.transaction_id = t.transaction_id
WHERE
    f.fraud_prediction = 'Fraud'
GROUP BY
    DATE_TRUNC('month', t.transaction_timestamp)
ORDER BY
    transaction_month;
