--=============================================================
--01: Fraud Transaction Distribution
--=============================================================

SELECT
    fraud_prediction,
    COUNT(*) AS total_transactions
FROM fraud_prediction
GROUP BY
    fraud_prediction
ORDER BY
    total_transactions DESC;


    --=============================================================
--02: Fraud Transaction Rate
--=============================================================

SELECT
    total_transactions,
    fraud_transactions,
    ROUND(
        (fraud_transactions * 100.0 / total_transactions),
        2
    ) AS fraud_rate_percentage
FROM (
    SELECT
        COUNT(*) AS total_transactions,
        COUNT(
            CASE
                WHEN fraud_prediction = 'Fraud'
                THEN 1
            END
        ) AS fraud_transactions
    FROM fraud_prediction
) AS a;


--=============================================================
--03: Fraud Transaction Value Analysis
--=============================================================

SELECT
    total_transaction_value,
    fraud_transaction_value,
    ROUND(
        fraud_transaction_value * 100.0 / total_transaction_value,
        2
    ) AS fraud_value_percentage
FROM (
    SELECT
        SUM(t.amount) AS total_transaction_value,
        SUM(
            CASE
                WHEN f.fraud_prediction = 'Fraud'
                THEN t.amount
            END
        ) AS fraud_transaction_value
    FROM transactions AS t
    INNER JOIN fraud_prediction AS f
        ON t.transaction_id = f.transaction_id
) AS fraud_summary;


--=============================================================
--04: Fraud Transactions by Payment Method
--=============================================================

SELECT
    p.payment_method,
    COUNT(
        CASE
            WHEN f.fraud_prediction = 'Fraud'
            THEN 1
        END
    ) AS fraud_transactions,
    SUM(
        CASE
            WHEN f.fraud_prediction = 'Fraud'
            THEN t.amount
        END
    ) AS fraud_transaction_value
FROM fraud_prediction AS f
INNER JOIN transactions AS t
    ON f.transaction_id = t.transaction_id
INNER JOIN payment_method AS p
    ON t.payment_method_id = p.payment_method_id
GROUP BY
    p.payment_method
ORDER BY
    fraud_transaction_value DESC;


--=============================================================
--05: Fraud Risk by Institution
--=============================================================

SELECT
    i.institution_name,
    COUNT(
        CASE
            WHEN f.fraud_prediction = 'Fraud'
            THEN 1
        END
    ) AS fraud_transactions,
    SUM(
        CASE
            WHEN f.fraud_prediction = 'Fraud'
            THEN t.amount
        END
    ) AS fraud_transaction_value
FROM fraud_prediction AS f
INNER JOIN transactions AS t
    ON f.transaction_id = t.transaction_id
INNER JOIN account AS a
    ON t.account_id = a.account_id
INNER JOIN institution AS i
    ON a.institution_id = i.institution_id
GROUP BY
    i.institution_name
ORDER BY
    fraud_transaction_value DESC;


