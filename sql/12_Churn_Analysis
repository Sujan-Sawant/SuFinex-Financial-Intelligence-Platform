--=============================================================
--10: Customer Churn Risk Prioritization
--=============================================================

WITH customer_value AS (
    SELECT
        c.customer_id,

        COALESCE(
            SUM(t.amount),
            0
        ) AS total_transaction_value,

        COUNT(t.transaction_id) AS total_transactions

    FROM customer AS c

    LEFT JOIN transactions AS t
        ON c.customer_id = t.customer_id

    GROUP BY
        c.customer_id
)

SELECT
    cv.customer_id,

    cv.total_transactions,

    ROUND(
        cv.total_transaction_value,
        2
    ) AS total_transaction_value,

    ROUND(
        p.churn_probability,
        4
    ) AS churn_probability,

    p.churn_risk_level,

    CASE
        WHEN p.churn_probability >= 0.70
             AND cv.total_transaction_value >= 500000
            THEN 'Critical'

        WHEN p.churn_probability >= 0.70
             AND cv.total_transaction_value < 500000
            THEN 'High'

        WHEN p.churn_probability >= 0.40
             AND cv.total_transaction_value >= 500000
            THEN 'High'

        WHEN p.churn_probability >= 0.40
             AND cv.total_transaction_value < 500000
            THEN 'Medium'

        ELSE 'Low'
    END AS retention_priority

FROM customer_value AS cv

INNER JOIN churn_prediction AS p
    ON cv.customer_id = p.customer_id

WHERE
    p.churn_prediction = 'Churn'
ORDER BY 
    retention_priority;
