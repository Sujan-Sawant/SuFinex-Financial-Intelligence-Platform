-- ============================================================
-- 01. Overall Transaction Summary
-- ============================================================

SELECT
    COUNT(*) AS total_transactions,

    COUNT(
        CASE
            WHEN transaction_status = 'Completed'
            THEN 1
        END
    ) AS completed_transactions,

    COUNT(
        CASE
            WHEN transaction_status = 'Failed'
            THEN 1
        END
    ) AS failed_transactions,

    COUNT(
        CASE
            WHEN transaction_status = 'Pending'
            THEN 1
        END
    ) AS pending_transactions,

    COUNT(
        CASE
            WHEN transaction_status = 'Reversed'
            THEN 1
        END
    ) AS reversed_transactions,

    ROUND(COALESCE(
        SUM(
            CASE
                WHEN transaction_status = 'Completed'
                THEN amount
                ELSE 0
            END
        ),
        0,2)
    ) AS total_transaction_value,

    ROUND(COALESCE(
        AVG(
            CASE
                WHEN transaction_status = 'Completed'
                THEN amount
            END
        ),
        0,2)
    ) AS average_transaction_value


-- ============================================================
-- 02. Transaction Analysis by Transaction Type
-- ============================================================

SELECT
    transaction_type,

    COUNT(*) AS transaction_count,

    COUNT(
        CASE
            WHEN transaction_status = 'Completed'
            THEN 1
        END
    ) AS completed_transactions,

    COALESCE(
        SUM(
            CASE
                WHEN transaction_status = 'Completed'
                THEN amount
                ELSE 0
            END
        ),
        0
    ) AS total_transaction_value,

    COALESCE(
        AVG(
            CASE
                WHEN transaction_status = 'Completed'
                THEN amount
            END
        ),
        0
    ) AS average_transaction_value

FROM transactions

GROUP BY
    transaction_type

ORDER BY
    total_transaction_value DESC;

