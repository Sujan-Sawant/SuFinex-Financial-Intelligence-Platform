--=====================================================================
-- 09 Fraud Rate by Institution
--=====================================================================

-- For each institution, calculate:

-- Total transactions
-- Fraud transactions
-- Fraud transaction rate (%)
-- Total fraud transaction value
-- Then rank institutions by fraud transaction rate.


WITH institution_fraud AS (
    SELECT
        i.institution_name,

        COUNT(*) AS total_transactions,

        COUNT(
            CASE
                WHEN f.fraud_prediction = 'Fraud'
                THEN 1
            END
        ) AS fraud_transactions,

        SUM(
            CASE
                WHEN f.fraud_prediction = 'Fraud'
                THEN t.amount
                ELSE 0
            END
        ) AS fraud_transaction_value

    FROM institution i
    INNER JOIN customer c
        ON i.institution_id = c.institution_id
    INNER JOIN transactions t
        ON c.customer_id = t.customer_id
    INNER JOIN fraud_prediction f
        ON t.transaction_id = f.transaction_id

    GROUP BY i.institution_name
),

final_analysis AS (
    SELECT
        *,
        ROUND(
            fraud_transactions::NUMERIC
            / NULLIF(total_transactions, 0) * 100,
            2
        ) AS fraud_transaction_rate
    FROM institution_fraud
)

SELECT
    *,
    RANK() OVER (
        ORDER BY fraud_transaction_rate DESC
    ) AS fraud_rank
FROM final_analysis
ORDER BY fraud_rank;
